---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="標籤" description="依標籤瀏覽 Tim Tsai 技術部落格的文章。">
	<div class="container">
		<header class="page-header">
			<h1>標籤</h1>
			<p>點選標籤查看相關文章。</p>
		</header>
		{
			tags.size > 0 ? (
				<ul class="tag-index">
					{[...tags.entries()].map(([tag, count]) => (
						<li>
							<a class="tag tag-large" href={`/tags/${tag}/`}>
								{tag}
								<span class="tag-count">{count}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p>尚無標籤。</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.tag-index {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tag-large {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9375rem;
		padding: 0.45rem 0.85rem;
	}

	.tag-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.5rem;
		height: 1.5rem;
		padding: 0 0.35rem;
		border-radius: 999px;
		background: var(--bg);
		font-size: 0.75rem;
		color: var(--text-muted);
	}
</style>
